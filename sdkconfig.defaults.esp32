# ESP32 (classic). No USB-Serial-JTAG on this part, so the console stays on UART0
# via the board's USB-UART bridge -- one of the conveniences PLAN §1a warns cannot
# be assumed across targets.
# Heltec WiFi LoRa 32 V2: 8 MB flash (esptool flash_id).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Heltec WiFi LoRa 32 V2: white LED on GPIO25.
CONFIG_APP_LED_TYPE_GPIO=y
CONFIG_APP_LED_GPIO=25

# Shed Wi-Fi is weak: wait the maximum before raising the provisioning AP, so a
# provisioned node does not keep advertising a setup network when Wi-Fi drops.
CONFIG_APP_NET_FALLBACK_DELAY_S=3600

# Signing key. A classic ESP32 below revision v3.0 has no RSA secure boot v2, so the app
# signing scheme falls back to v1 ECDSA (NIST P-256) and the key is a different kind of
# file from the RSA-3072 one every other target uses. Raising CONFIG_ESP32_REV_MIN to
# v3.0 would unify them at the cost of refusing to boot on older silicon; keeping the
# second key keeps those boards supported. See tools/gen_signing_key.sh.
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/app_signing_ecdsa256.pem"

# Shed Wi-Fi is weak: give a new image 30 minutes, not 10, to reach the update server
# before it is reverted. The update itself just arrived over Wi-Fi, so it usually passes
# in the first minutes.
CONFIG_APP_OTA_SELFTEST_TIMEOUT_S=1800

# RadioLib's ESP-IDF HAL needs a 1 ms tick: LoRaWAN receive windows open 1-2 s after an
# uplink and must be hit to within a few milliseconds.
CONFIG_FREERTOS_HZ=1000
