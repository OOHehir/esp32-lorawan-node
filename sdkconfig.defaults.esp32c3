# ESP32-C3.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# UART0 primary; IDF adds USB-Serial-JTAG as a secondary console on this part.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ESP32-C3-DevKitM-1: addressable LED on GPIO8.
CONFIG_APP_LED_TYPE_ADDRESSABLE=y
CONFIG_APP_LED_GPIO=8
